# Aegis backend environment
# No secret API keys here — Vertex AI uses Application Default Credentials (gcloud auth / service account).

GOOGLE_CLOUD_PROJECT=your-project-id
# gemini-3.5-flash is served from the global Vertex endpoint (not us-central1)
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash

RECEIPTS_BUCKET=your-project-id-aegis-receipts
TRANSACTIONS_TOPIC=transactions
