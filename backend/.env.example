# Aegis backend environment
# No secret API keys here — Vertex AI uses Application Default Credentials (gcloud auth / service account).

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Confirm the exact current model id in Vertex AI Model Garden before deploy.
GEMINI_MODEL=gemini-3.5-pro
GEMINI_FLASH_MODEL=gemini-3.5-flash

RECEIPTS_BUCKET=your-project-id-aegis-receipts
TRANSACTIONS_TOPIC=transactions
